# Hayashi OS: variáveis de ambiente
# Copie este arquivo para .env (na raiz do projeto) e preencha SÓ o que for usar.
# O .env nunca vai pro repositório. Nenhuma função do dia a dia precisa de chave.

# ---------- Transcrição automática de vídeo (/video legendar) ----------
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1

# ---------- Publicar nas redes públicas da Hayashi (/aprovar-post) ----------
# Só a Comunicação, com aprovação da diretoria. Token de longa duração da Página.
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
META_GRAPH_VERSION=v23.0
# Hospedagem pública das imagens: site da empresa (SITE_URL) ou imgbb
SITE_URL=
IMGBB_API_KEY=
IMGBB_EXPIRACAO=86400

# ---------- Geração de imagem por IA (opcional; nunca pra representar a Hayashi) ----------
IMAGEM_PROVEDOR=openai
OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ---------- ffmpeg fora do PATH (opcional) ----------
# FFMPEG_DIR=C:\ffmpeg\bin
